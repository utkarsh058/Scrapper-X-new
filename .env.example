# ==============================================================================
# LeadPilot Environment Configuration Template
# ==============================================================================

# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@endpoint-pooler.region.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@endpoint.region.neon.tech/neondb?sslmode=require"

# Discovery Provider Priority & Selection
# Options: "outscraper" (primary, default) | "google_places"
PRIMARY_DISCOVERY_PROVIDER="outscraper"

# Outscraper Google Maps Engine - Primary Discovery Provider
OUTSCRAPER_ENABLED=true
OUTSCRAPER_API_KEY=your_outscraper_api_key_here
OUTSCRAPER_TIMEOUT_MS=15000
OUTSCRAPER_CONCURRENCY=2

# Google Places API (New) - Modular / Future Compatible (Disabled by default)
# To activate Google Places in the future:
# 1. Set GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
# 2. Set GOOGLE_PLACES_ENABLED=true
# 3. Set PRIMARY_DISCOVERY_PROVIDER="google_places" (or keep "outscraper" with Google Places as secondary)
GOOGLE_PLACES_ENABLED=false
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_TIMEOUT_MS=8000
GOOGLE_PLACES_CONCURRENCY=3

# OpenStreetMap (Overpass API) - Secondary / Fallback Discovery Provider
OSM_ENABLED=true
OSM_TIMEOUT_MS=4000
OSM_CONCURRENCY=2
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_API_FALLBACKS=https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter

# Google PageSpeed Insights API (v5) - Website Performance & Core Web Vitals
# Optional: Used by WebsiteAuditEngine to benchmark real Lighthouse Performance,
# LCP, INP, CLS, FCP, TTFB, and Speed Index for audited domains.
# If not configured, LeadPilot truthfully reports status as NOT_CONFIGURED and
# leaves performance scores as null/unavailable without fabricating fake scores.
PAGESPEED_API_KEY=

# Internal Crawler Settings
WEBSITE_CRAWL_PAGE_LIMIT=2

# Phone Verification — Twilio Lookup (Optional)
# When configured, enables carrier-level phone verification (MOBILE/LANDLINE/VOIP classification).
# Without this, LeadPilot uses libphonenumber for syntax-level validation only.
# Status will be reported as UNAVAILABLE (not VERIFIED) when not configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Email Verification — ZeroBounce (Optional)
# When configured, enables mailbox-level deliverability verification.
# Without this, LeadPilot uses DNS MX record checking only (MX_VALID ≠ DELIVERABILITY_VERIFIED).
# Status will be reported as UNAVAILABLE (not VERIFIED) when not configured.
ZEROBOUNCE_API_KEY=

# Contact Verification Control Flags (Optional)
CONTACT_PHONE_EXTERNAL_VERIFICATION=true
CONTACT_EMAIL_EXTERNAL_VERIFICATION=true
CONTACT_VERIFICATION_TTL_DAYS=30

# Email Verification — Generic (Optional, legacy)
EMAIL_VERIFICATION_API_KEY=
