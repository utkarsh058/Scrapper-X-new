generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Business {
  id               String               @id @default(cuid())
  name             String
  legalName        String?
  category         String
  industry         String
  address          String?
  city             String?
  state            String?
  country          String               @default("India")
  postcode         String?
  latitude         Float?
  longitude        Float?
  phone            String?
  email            String?
  websiteUrl       String?
  rating           Float?
  reviewCount      Int?
  businessStatus   String               @default("OPERATIONAL")
  opportunityScore Int                  @default(0)
  status           String               @default("New")
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  sources          BusinessSource[]
  contacts         Contact[]
  evidence         LeadEvidence[]
  scores           LeadScore[]
  signals          MarketingSignal[]
  outreach         Outreach[]
  outreachLogs     OutreachAuditLog[]
  verifications    VerificationResult[]
  websites         Website[]
  audits           WebsiteAudit[]

  @@index([city, state])
  @@index([industry])
  @@index([opportunityScore])
}

model BusinessSource {
  id          String   @id @default(cuid())
  businessId  String
  provider    String
  sourceId    String
  sourceUrl   String?
  rawPayload  String?
  collectedAt DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([provider, sourceId])
}

model Contact {
  id                 String               @id @default(cuid())
  businessId         String
  name               String?
  role               String?
  type               String               @default("GENERIC_BUSINESS")
  email              String?
  phone              String?
  linkedin           String?
  verificationStatus String               @default("UNVERIFIED")
  sourceUrl          String?
  createdAt          DateTime             @default(now())
  business           Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  verifications      VerificationResult[]

  @@index([businessId])
}

model Website {
  id            String         @id @default(cuid())
  businessId    String
  url           String
  domain        String
  isHttps       Boolean        @default(false)
  httpStatus    Int?
  status        String         @default("Working")
  lastCheckedAt DateTime       @default(now())
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  audits        WebsiteAudit[]

  @@index([businessId])
  @@index([domain])
}

model WebsiteAudit {
  id                 String   @id @default(cuid())
  businessId         String
  websiteId          String?
  url                String
  status             String   @default("Working")
  performanceScore   Int?
  accessibilityScore Int?
  bestPracticesScore Int?
  seoScore           Int?
  responseTimeMs     Int?
  hasMobileViewport  Boolean  @default(false)
  hasContactForm     Boolean  @default(false)
  hasBookingCta      Boolean  @default(false)
  hasPhoneCta        Boolean  @default(false)
  hasWhatsappLink    Boolean  @default(false)
  detectedIssues     String
  rawAuditPayload    String?
  auditedAt          DateTime @default(now())
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  website            Website? @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model MarketingSignal {
  id         String   @id @default(cuid())
  businessId String
  signalType String
  name       String
  value      String
  sourceUrl  String?
  confidence Float    @default(1.0)
  observedAt DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model VerificationResult {
  id          String   @id @default(cuid())
  businessId  String
  contactId   String?
  targetType  String
  targetValue String
  provider    String
  status      String
  details     String?
  confidence  Float    @default(1.0)
  verifiedAt  DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact     Contact? @relation(fields: [contactId], references: [id])

  @@index([businessId])
}

model LeadScore {
  id                  String   @id @default(cuid())
  businessId          String
  opportunityScore    Int      @default(0)
  fitScore            Int      @default(0)
  needScore           Int      @default(0)
  contactabilityScore Int      @default(0)
  evidenceScore       Int      @default(0)
  reasons             String
  calculatedAt        DateTime @default(now())
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model LeadEvidence {
  id           String   @id @default(cuid())
  businessId   String
  evidenceType String
  claim        String
  sourceUrl    String?
  snippet      String?
  confidence   Float    @default(1.0)
  observedAt   DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Outreach {
  id                 String             @id @default(cuid())
  businessId         String
  campaignId         String?
  channel            String             @default("EMAIL")
  recipient          String
  subject            String?
  message            String
  status             String             @default("PENDING")
  provider           String?
  providerMessageId  String?
  verificationStatus String?
  evidenceUsed       String?
  errorCode          String?
  errorMessage       String?
  excelSyncStatus    String?            @default("PENDING")
  excelSyncError     String?
  sentAt             DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  failedAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign           Campaign?          @relation(fields: [campaignId], references: [id])
  auditLogs          OutreachAuditLog[]

  @@index([businessId])
  @@index([campaignId])
  @@index([channel, recipient])
  @@index([status])
}

model Campaign {
  id          String     @id @default(cuid())
  name        String
  description String?
  status      String     @default("ACTIVE")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  outreaches  Outreach[]
}

model SuppressionList {
  id        String   @id @default(cuid())
  contact   String
  channel   String   @default("ALL")
  reason    String
  source    String?
  createdAt DateTime @default(now())

  @@unique([contact, channel])
  @@index([contact])
}

model OutreachAuditLog {
  id         String    @id @default(cuid())
  userId     String?
  businessId String
  outreachId String?
  action     String
  channel    String
  provider   String?
  metadata   String?
  timestamp  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outreach   Outreach? @relation(fields: [outreachId], references: [id])

  @@index([businessId])
  @@index([outreachId])
  @@index([action])
}

model Job {
  id              String        @id @default(cuid())
  type            String        @default("LEAD_SEARCH")
  status          String        @default("PENDING")
  criteria        String
  totalDiscovered Int           @default(0)
  totalProcessed  Int           @default(0)
  totalQualified  Int           @default(0)
  error           String?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  pipelineRuns    PipelineRun[]
}

model PipelineRun {
  id               String     @id @default(cuid())
  jobId            String
  status           String     @default("RUNNING")
  stage            String     @default("TARGET_CREATED")
  recordsProcessed Int        @default(0)
  recordsFailed    Int        @default(0)
  startedAt        DateTime   @default(now())
  completedAt      DateTime?
  error            String?
  actorRuns        ActorRun[]
  job              Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model ActorRun {
  id            String      @id @default(cuid())
  pipelineRunId String
  actorName     String
  status        String      @default("RUNNING")
  inputCount    Int         @default(0)
  outputCount   Int         @default(0)
  durationMs    Int         @default(0)
  error         String?
  createdAt     DateTime    @default(now())
  pipelineRun   PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@index([pipelineRunId])
}

model SearchResultHistory {
  id             String   @id @default(cuid())
  placeId        String
  jobId          String
  fingerprintKey String
  businessName   String
  deliveredAt    DateTime @default(now())

  @@index([fingerprintKey])
  @@index([placeId])
  @@index([deliveredAt])
}
