generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Business {
  id               String               @id @default(cuid())
  name             String
  legalName        String?
  category         String
  industry         String
  address          String?
  city             String?
  state            String?
  country          String               @default("India")
  countryCode      String?              @default("IN")
  regionCode       String?
  timezone         String?
  postcode         String?
  latitude         Float?
  longitude        Float?
  phone            String?
  email            String?
  websiteUrl       String?
  rating           Float?
  reviewCount      Int?
  businessStatus   String               @default("OPERATIONAL")
  opportunityScore Int                  @default(0)
  status           String               @default("New")
  tenantId         String?
  tenant           Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  sources          BusinessSource[]
  contacts         Contact[]
  evidence         LeadEvidence[]
  scores           LeadScore[]
  signals          MarketingSignal[]
  outreach         Outreach[]
  outreachLogs     OutreachAuditLog[]
  verifications    VerificationResult[]
  websites         Website[]
  audits           WebsiteAudit[]
  googleProfile    GoogleBusinessProfile?
  socialProfiles   SocialProfile[]
  reviewSummary    ReviewSummary?
  reviews          Review[]
  sourceEvidences  SourceEvidence[]
  commercialMilestones CommercialMilestone[]

  @@index([city, state])
  @@index([industry])
  @@index([opportunityScore])
  @@index([tenantId])
  @@index([countryCode])
}

model BusinessSource {
  id          String   @id @default(cuid())
  businessId  String
  provider    String
  sourceId    String
  sourceUrl   String?
  rawPayload  String?
  collectedAt DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([provider, sourceId])
}

model Contact {
  id                 String               @id @default(cuid())
  businessId         String
  name               String?
  role               String?
  contactType        String               @default("PHONE")       // PHONE | EMAIL | WHATSAPP | CONTACT_FORM | SOCIAL | OTHER
  type               String               @default("GENERIC_BUSINESS")
  rawValue           String?
  normalizedValue    String?
  email              String?
  phone              String?
  linkedin           String?
  domain             String?
  countryCode        String?
  lineType           String?              // MOBILE | LANDLINE | VOIP | UNKNOWN
  source             String?              // google_places | osm | official_website | web_search
  sourceUrl          String?
  sourceProvider     String?              // Provider name that discovered this contact
  confidence         Float                @default(0.0)
  verificationStatus String               @default("UNVERIFIED")  // UNKNOWN | UNVERIFIED | VERIFIED | INVALID | RISKY | BOUNCED | DISPOSABLE | ROLE_BASED | UNAVAILABLE
  verifiedAt         DateTime?
  firstDiscoveredAt  DateTime             @default(now())
  lastCheckedAt      DateTime?
  isPrimary          Boolean              @default(false)
  isPublic           Boolean              @default(true)
  isRoleBased        Boolean              @default(false)
  isDisposable       Boolean              @default(false)
  evidence           String?              // JSON: extraction evidence snippet
  metadata           String?              // JSON: additional provider-specific data
  createdAt          DateTime             @default(now())
  business           Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  verifications      VerificationResult[]
  contactVerifications ContactVerification[]

  @@index([businessId])
  @@index([contactType, verificationStatus])
  @@index([normalizedValue])
}

model ContactVerification {
  id              String   @id @default(cuid())
  contactId       String
  provider        String                // dns_mx | libphonenumber | twilio_lookup | zerobounce | hunter | internal
  status          String                // VERIFIED | INVALID | RISKY | UNKNOWN | DISPOSABLE | ROLE_BASED | BOUNCED | UNAVAILABLE | FORMAT_VALID | DOMAIN_VALID | MX_VALID | DELIVERABILITY_VERIFIED
  level           String   @default("SYNTAX")  // SYNTAX | DOMAIN | MX | DELIVERABILITY | CARRIER
  hasValidSyntax  Boolean  @default(false)
  hasMxRecords    Boolean?
  isDisposable    Boolean  @default(false)
  isRoleBased     Boolean  @default(false)
  lineType        String?               // MOBILE | LANDLINE | VOIP | UNKNOWN
  carrier         String?
  confidence      Float    @default(0.0)
  details         String?               // JSON: provider-specific details
  verifiedAt      DateTime @default(now())
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId])
  @@index([provider])
}

model Website {
  id            String         @id @default(cuid())
  businessId    String
  url           String
  domain        String
  isHttps       Boolean        @default(false)
  httpStatus    Int?
  status        String         @default("Working")
  lastCheckedAt DateTime       @default(now())
  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  audits        WebsiteAudit[]

  @@index([businessId])
  @@index([domain])
}

model WebsiteAudit {
  id                 String   @id @default(cuid())
  businessId         String
  websiteId          String?
  url                String
  status             String   @default("Working")
  performanceScore   Int?
  accessibilityScore Int?
  bestPracticesScore Int?
  seoScore           Int?
  responseTimeMs     Int?
  hasMobileViewport  Boolean  @default(false)
  hasContactForm     Boolean  @default(false)
  hasBookingCta      Boolean  @default(false)
  hasPhoneCta        Boolean  @default(false)
  hasWhatsappLink    Boolean  @default(false)
  detectedIssues     String
  rawAuditPayload    String?
  auditedAt          DateTime @default(now())
  business           Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  website            Website? @relation(fields: [websiteId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model MarketingSignal {
  id         String   @id @default(cuid())
  businessId String
  signalType String
  name       String
  value      String
  sourceUrl  String?
  confidence Float    @default(1.0)
  observedAt DateTime @default(now())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model VerificationResult {
  id          String   @id @default(cuid())
  businessId  String
  contactId   String?
  targetType  String
  targetValue String
  provider    String
  status      String
  details     String?
  confidence  Float    @default(1.0)
  verifiedAt  DateTime @default(now())
  business    Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  contact     Contact? @relation(fields: [contactId], references: [id])

  @@index([businessId])
}

model LeadScore {
  id                  String   @id @default(cuid())
  businessId          String
  opportunityScore    Int      @default(0)
  fitScore            Int      @default(0)
  needScore           Int      @default(0)
  contactabilityScore Int      @default(0)
  evidenceScore       Int      @default(0)
  reasons             String
  calculatedAt        DateTime @default(now())
  business            Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model LeadEvidence {
  id           String   @id @default(cuid())
  businessId   String
  evidenceType String
  claim        String
  sourceUrl    String?
  snippet      String?
  confidence   Float    @default(1.0)
  observedAt   DateTime @default(now())
  business     Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
}

model Outreach {
  id                 String             @id @default(cuid())
  businessId         String
  campaignId         String?
  channel            String             @default("EMAIL")
  recipient          String
  subject            String?
  message            String
  status             String             @default("PENDING")
  provider           String?
  providerMessageId  String?
  verificationStatus String?
  evidenceUsed       String?
  errorCode          String?
  errorMessage       String?
  excelSyncStatus    String?            @default("PENDING")
  excelSyncError     String?
  sentAt             DateTime?
  deliveredAt        DateTime?
  readAt             DateTime?
  failedAt           DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  business           Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign           Campaign?          @relation(fields: [campaignId], references: [id])
  auditLogs          OutreachAuditLog[]

  @@index([businessId])
  @@index([campaignId])
  @@index([channel, recipient])
  @@index([status])
}

model Campaign {
  id          String     @id @default(cuid())
  name        String
  description String?
  status      String     @default("ACTIVE")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  outreaches  Outreach[]
}

model SuppressionList {
  id        String   @id @default(cuid())
  contact   String
  channel   String   @default("ALL")
  reason    String
  source    String?
  createdAt DateTime @default(now())

  @@unique([contact, channel])
  @@index([contact])
}

model OutreachAuditLog {
  id         String    @id @default(cuid())
  userId     String?
  businessId String
  outreachId String?
  action     String
  channel    String
  provider   String?
  metadata   String?
  timestamp  DateTime  @default(now())
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  outreach   Outreach? @relation(fields: [outreachId], references: [id])

  @@index([businessId])
  @@index([outreachId])
  @@index([action])
}

model Job {
  id              String        @id @default(cuid())
  type            String        @default("LEAD_SEARCH")
  status          String        @default("PENDING")
  criteria        String
  totalDiscovered Int           @default(0)
  totalProcessed  Int           @default(0)
  totalQualified  Int           @default(0)
  error           String?
  createdAt       DateTime      @default(now())
  completedAt     DateTime?
  pipelineRuns    PipelineRun[]
}

model PipelineRun {
  id               String     @id @default(cuid())
  jobId            String
  status           String     @default("RUNNING")
  stage            String     @default("TARGET_CREATED")
  recordsProcessed Int        @default(0)
  recordsFailed    Int        @default(0)
  startedAt        DateTime   @default(now())
  completedAt      DateTime?
  error            String?
  actorRuns        ActorRun[]
  job              Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
}

model ActorRun {
  id            String      @id @default(cuid())
  pipelineRunId String
  actorName     String
  status        String      @default("RUNNING")
  inputCount    Int         @default(0)
  outputCount   Int         @default(0)
  durationMs    Int         @default(0)
  error         String?
  createdAt     DateTime    @default(now())
  pipelineRun   PipelineRun @relation(fields: [pipelineRunId], references: [id], onDelete: Cascade)

  @@index([pipelineRunId])
}

model SearchResultHistory {
  id             String   @id @default(cuid())
  placeId        String
  jobId          String
  fingerprintKey String
  businessName   String
  deliveredAt    DateTime @default(now())

  @@index([fingerprintKey])
  @@index([placeId])
  @@index([deliveredAt])
}

model GoogleBusinessProfile {
  id                         String         @id @default(cuid())
  businessId                 String         @unique
  placeId                    String         @unique
  rating                     Float?
  reviewCount                Int?
  googleMapsUrl              String?
  businessStatus             String?        @default("OPERATIONAL")
  priceLevel                 Int?
  profileCreatedAt           DateTime?
  profileCreatedAtType       String         @default("NOT_AVAILABLE")
  firstSeenAt                DateTime?
  lastCheckedAt              DateTime       @default(now())
  rawPayload                 String?
  business                   Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  reviews                    Review[]
  reviewSummary              ReviewSummary?

  @@index([placeId])
  @@index([rating])
  @@index([reviewCount])
}

model ReviewSummary {
  id                          String                 @id @default(cuid())
  businessId                  String                 @unique
  googleProfileId             String?                @unique
  rating                      Float?
  reviewCount                 Int?
  reviewLevelDataAvailable    Boolean                @default(false)
  earliestAvailableReviewDate DateTime?
  source                      String                 @default("google_places")
  capturedAt                  DateTime               @default(now())
  business                    Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  googleProfile               GoogleBusinessProfile? @relation(fields: [googleProfileId], references: [id], onDelete: Cascade)
  reviews                     Review[]

  @@index([businessId])
}

model Review {
  id              String                 @id @default(cuid())
  businessId      String
  googleProfileId String?
  reviewSummaryId String?
  authorName      String?
  rating          Int
  text            String?
  publishTime     DateTime?
  source          String                 @default("google_places")
  capturedAt      DateTime               @default(now())
  business        Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  googleProfile   GoogleBusinessProfile? @relation(fields: [googleProfileId], references: [id])
  reviewSummary   ReviewSummary?         @relation(fields: [reviewSummaryId], references: [id])

  @@index([businessId])
  @@index([rating])
}

model SocialProfile {
  id                   String                  @id @default(cuid())
  businessId           String
  platform             String                  // instagram, facebook, youtube, linkedin, tiktok, twitter, pinterest, threads, whatsapp_business, other
  profileUrl           String?
  username             String?
  displayName          String?
  description          String?
  followers            Int?
  displayFollowerCount String?
  isRounded            Boolean?
  following            Int?
  posts                Int?
  subscribers          Int?
  videos               Int?
  likes                Int?
  verified             Boolean?
  createdAt            DateTime?
  createdAtType        String                  @default("NOT_AVAILABLE") // OFFICIAL_API | NOT_AVAILABLE
  firstSeenAt          DateTime?
  lastActivityAt       DateTime?
  source               String                  // website_header, website_footer, website_jsonld, official_api
  confidence           Float                   @default(1.0)
  createdAtSource      String?
  metricStatus         String?                 @default("NOT_AVAILABLE") // AVAILABLE | NOT_AVAILABLE | NOT_CONFIGURED | UNAUTHORIZED | RATE_LIMITED | API_ERROR | PROFILE_NOT_FOUND
  metricSource         String?
  metricSourceType     String?                 @default("NONE")          // OFFICIAL_API | PUBLIC_WEB | WEBSITE_METADATA | NONE
  followersFetchedAt   DateTime?
  verificationStatus   String?                 @default("UNVERIFIED")    // VERIFIED | UNVERIFIED | REJECTED

  // Creation Date Enrichment V2
  accountCreatedAt             DateTime?
  accountCreatedDatePrecision  String?                 // DAY | MONTH | YEAR
  accountCreatedConfidence     String?                 // HIGH | MEDIUM | LOW
  accountCreatedStatus         String?                 @default("NOT_AVAILABLE") // VERIFIED_EXACT | VERIFIED_MONTH | VERIFIED_YEAR | FIRST_OBSERVED_ONLY | NOT_AVAILABLE | CONFLICT
  accountCreatedSourceType     String?                 // PUBLIC_PROFILE | SEARCH_ENGINE | PUBLIC_ARCHIVE | NONE
  accountCreatedSourceUrl      String?
  accountCreatedEvidenceText   String?
  accountCreatedFetchedAt      DateTime?
  firstObservedAt              DateTime?
  firstObservedSourceType      String?
  firstObservedSourceUrl       String?
  firstObservedEvidenceText    String?
  earliestPublicPostAt         DateTime?
  earliestPublicPostSourceUrl  String?

  lastCheckedAt        DateTime                @default(now())
  business             Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  snapshots            SocialProfileSnapshot[]
  sourceEvidences      SourceEvidence[]

  @@index([businessId])
  @@index([platform, username])
  @@index([platform, profileUrl])
}

model SocialProfileSnapshot {
  id                          String        @id @default(cuid())
  profileId                   String
  followers                   Int?
  displayFollowerCount        String?
  isRounded                   Boolean?
  following                   Int?
  posts                       Int?
  subscribers                 Int?
  videos                      Int?
  likes                       Int?
  isVerified                  Boolean?
  metricStatus                String?       @default("NOT_AVAILABLE")
  metricSourceType            String?       @default("NONE")
  accountCreatedAt            DateTime?
  accountCreatedAtType        String?       @default("NOT_AVAILABLE")

  // Creation Date Enrichment V2
  accountCreatedDatePrecision String?
  accountCreatedConfidence    String?
  accountCreatedStatus        String?       @default("NOT_AVAILABLE")
  accountCreatedSourceType    String?
  accountCreatedSourceUrl     String?
  accountCreatedEvidenceText  String?
  accountCreatedFetchedAt     DateTime?
  firstObservedAt             DateTime?
  firstObservedSourceType     String?
  firstObservedSourceUrl      String?
  firstObservedEvidenceText   String?
  earliestPublicPostAt        DateTime?
  earliestPublicPostSourceUrl String?

  capturedAt                  DateTime      @default(now())
  source                      String
  profile                     SocialProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([capturedAt])
}

model SourceEvidence {
  id              String         @id @default(cuid())
  entityType      String         // business, contact, social_profile, review_summary
  entityId        String
  field           String
  value           String
  source          String
  capturedAt      DateTime       @default(now())
  confidence      String         @default("HIGH") // HIGH, MEDIUM, LOW
  metadata        String?
  businessId      String?
  socialProfileId String?
  business        Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  socialProfile   SocialProfile? @relation(fields: [socialProfileId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
  @@index([businessId])
}

model Tenant {
  id                     String            @id @default(cuid())
  name                   String
  slug                   String            @unique
  allowedCountries       String[]          @default(["IN", "US", "CA"])
  maxBusinessesPerSearch Int               @default(500)
  monthlyBusinessLimit   Int               @default(10000)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  users                  User[]
  memberships            Membership[]
  searches               SearchJobRecord[]
  businesses             Business[]
}

model User {
  id          String            @id @default(cuid())
  email       String            @unique
  name        String?
  role        String            @default("MEMBER") // OWNER | ADMIN | MEMBER | VIEWER
  tenantId    String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships Membership[]
  searches    SearchJobRecord[]

  @@index([tenantId])
  @@index([email])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  role      String   @default("MEMBER") // OWNER | ADMIN | MEMBER | VIEWER
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@index([userId])
}

model SearchJobRecord {
  id                 String    @id @default(cuid())
  tenantId           String
  userId             String?
  searchId           String    @unique
  query              String
  countryCode        String    @default("IN")
  regionCode         String?
  regionName         String?
  cityName           String?
  postalCode         String?
  status             String    @default("CREATED") // CREATED | DISCOVERING | READY | FAILED
  requestedCount     Int       @default(50)
  discoveredCount    Int       @default(0)
  rawDiscoveredCount Int       @default(0)
  duplicatesCount    Int       @default(0)
  deduplicatedCount  Int       @default(0)
  excludedCount      Int       @default(0)
  eligibleCount      Int       @default(0)
  persistedCount     Int       @default(0)
  failedCount        Int       @default(0)
  error              String?
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user               User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([searchId])
  @@index([countryCode])
}

model CommercialMilestone {
  id              String   @id @default(cuid())
  businessId      String
  metricType      String   // GMV, SALES, REVENUE, ARR, FUNDING, VALUATION, TRANSACTION_VOLUME
  amount          Float?
  currency        String?
  formattedAmount String?
  date            DateTime?
  datePrecision   String?  // DAY, MONTH, QUARTER, YEAR
  period          String?  // FY23, Q1 2024
  sourceUrl       String?
  sourceType      String?  // PRIMARY, SECONDARY, INTERVIEW, FUNDING_REPORT, SEARCH_SNIPPET
  evidenceText    String?
  confidence      String   @default("HIGH") // HIGH, MEDIUM, LOW
  status          String   @default("NOT_AVAILABLE") // VERIFIED, NOT_AVAILABLE, CONFLICT
  capturedAt      DateTime @default(now())
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([metricType])
}
